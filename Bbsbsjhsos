}

local CONFIG_FOLDER = "MultiBossHunter"
local CONFIG_FILE = CONFIG_FOLDER .. "/Settings.json"

--==================================================
-- CONFIGURATION SAVE
--==================================================

local SaveGeneration = 0

local function SaveConfig()

    if not writefile then
        return false
    end

    if makefolder then
        if not isfolder or not isfolder(CONFIG_FOLDER) then
            pcall(function()
                makefolder(CONFIG_FOLDER)
            end)
        end
    end

    local Data = {
        SelectedBoss = Config.SelectedBoss,

        AutoServerHop = Config.AutoServerHop,
        AutoTargetEnabled = Config.AutoTargetEnabled,
        AutoFireEnabled = Config.AutoFireEnabled,

        AutoFireInterval = Config.AutoFireInterval,

        LockPosition = Config.LockPosition,

        X = Config.X,
        Y = Config.Y,
        Z = Config.Z,

        EmptyServerDelay = Config.EmptyServerDelay
    }

    local Success, Error = pcall(function()
        writefile(
            CONFIG_FILE,
            HttpService:JSONEncode(Data)
        )
    end)

    if not Success then
        warn("[Hunter] Save failed:", Error)
        return false
    end

    return true
end

--==================================================
-- AUTO SAVE DEBOUNCE
--==================================================

local function ScheduleSave()

    SaveGeneration = SaveGeneration + 1

    local MyGeneration = SaveGeneration

    task.delay(0.3, function()

        if MyGeneration ~= SaveGeneration then
            return
        end

        SaveConfig()

    end)

end

--==================================================
-- LOAD CONFIGURATION
--==================================================

local function LoadConfig()

    if not isfile or not readfile then
        return false
    end

    if not isfile(CONFIG_FILE) then
        return false
    end

    local Success, Data = pcall(function()
        return HttpService:JSONDecode(
            readfile(CONFIG_FILE)
        )
    end)

    if not Success or type(Data) ~= "table" then
        return false
    end

    if type(Data.SelectedBoss) == "string" then

        for _, Name in ipairs(BossOptions) do
            if Data.SelectedBoss == Name then
                Config.SelectedBoss = Name
                break
            end
        end

    end

    for _, Key in ipairs({
        "AutoServerHop",
        "AutoTargetEnabled",
        "AutoFireEnabled",
        "LockPosition"
    }) do

        if type(Data[Key]) == "boolean" then
            Config[Key] = Data[Key]
        end

    end

    for _, Key in ipairs({
        "AutoFireInterval",
        "X",
        "Y",
        "Z",
        "EmptyServerDelay"
    }) do

        if type(Data[Key]) == "number" then
            Config[Key] = Data[Key]
        end

    end

    Config.AutoFireInterval = math.max(
        0.21,
        Config.AutoFireInterval
    )

    Config.EmptyServerDelay = math.max(
        2,
        Config.EmptyServerDelay
    )

    -- Always start master automation enabled.
    Config.MasterEnabled = true

    return true
end

LoadConfig()

